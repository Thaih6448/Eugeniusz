@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@EUGENIUSZ_LLAMA@ AND NOT @BUILD_SHARED_LIBS@)
  find_dependency(llama CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/EugeniuszTargets.cmake")
if(@EUGENIUSZ_LLAMA@ AND NOT TARGET Eugeniusz::llama)
  find_library(Eugeniusz_LLAMA_LIBRARY NAMES eugeniusz_llama HINTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" REQUIRED NO_DEFAULT_PATH)
  add_library(Eugeniusz::llama UNKNOWN IMPORTED)
  set_target_properties(Eugeniusz::llama PROPERTIES IMPORTED_LOCATION "${Eugeniusz_LLAMA_LIBRARY}" INTERFACE_LINK_LIBRARIES Eugeniusz::eugeniusz)
  if(NOT @BUILD_SHARED_LIBS@)
    set_property(TARGET Eugeniusz::llama APPEND PROPERTY INTERFACE_LINK_LIBRARIES llama)
  endif()
endif()
check_required_components(Eugeniusz)
